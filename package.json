{
  "name": "unionkitbot",
  "version": "1.0.0",
  "private": true,
  "description": "UnionKitBot - autonomous Minecraft kit-delivery bot for Linux VPS",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm -r --filter \"./apps/**\" build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:api": "pnpm --filter @unionkitbot/api dev",
    "dev:agent": "pnpm --filter @unionkitbot/agent dev",
    "dev:ui": "pnpm --filter @unionkitbot/ui dev",
    "dev:discord": "pnpm --filter @unionkitbot/discord dev",
    "db:migrate": "pnpm --filter @unionkitbot/database migrate"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vec3": "0.1.10",
    "vitest": "^2.1.8"
  }
}
