# UnionKitBot environment template.
#
# Copy to .env, fill in the secrets, and never commit the result.
#   cp .env.example .env
# Generate strong values with:  openssl rand -hex 32

# ---------------------------------------------------------------- core
NODE_ENV=production
# trace|debug|info|warn|error
LOG_LEVEL=info

# ------------------------------------------------------------ database
POSTGRES_USER=unionkitbot
# REQUIRED. Used to build DATABASE_URL for the containers.
POSTGRES_PASSWORD=change-me-openssl-rand-hex-32
POSTGRES_DB=unionkitbot
# Set directly only when running outside docker compose.
# DATABASE_URL=postgres://unionkitbot:password@localhost:5432/unionkitbot

# --------------------------------------------------------------- redis
# Set directly only when running outside docker compose.
# REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------- api
# REQUIRED, minimum 16 characters. This is the token the UI and Discord send.
API_SECRET=change-me-openssl-rand-hex-32
API_HOST=0.0.0.0
API_PORT=8080
WS_PATH=/api/ws
AGENT_CONTROL_URL=ws://agent:8090
AGENT_HEARTBEAT_MS=15000
# Comma separated origins, or * to allow any origin.
CORS_ORIGINS=*

# ------------------------------------------------------------ minecraft
MC_DEFAULT_HOST=play.example.com
MC_DEFAULT_PORT=25565
# Leave blank to auto-detect the server version.
MC_DEFAULT_VERSION=
MC_DEFAULT_USERNAME=unionkitbot
# offline for cracked/anarchy servers, microsoft for official accounts.
MC_AUTH_TYPE=offline
# Only used with AuthMe-style /login servers. Never commit a real password.
MC_AUTHME_PASSWORD=
MC_CONFIG_PATH=/app/config/bots.json

# -------------------------------------------------------------- discord
# Official bot application credentials. Do NOT use a self-bot token.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_NOTIFY_CHANNEL_ID=
# Comma separated Discord user IDs permitted to control the bot.
DISCORD_ALLOWED_USERS=
# Comma separated Discord role IDs permitted to control the bot.
DISCORD_ALLOWED_ROLES=

# ------------------------------------------------------- optional llm
# When enabled, ambiguous chat is classified by an LLM. Its output is still validated
# deterministically before it can cause any Minecraft action.
LLM_CLASSIFIER_ENABLED=false
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

# ------------------------------------------------------------------ ui
# Bind address for the UI reverse proxy. Keep 127.0.0.1 unless a TLS proxy sits in front.
UI_BIND=127.0.0.1
UI_PORT=8080
UI_ACCENT_COLOR=#5aa469
